// Paleta azul suave y profesional
$sidebar-bg: #0f2d57;      // Azul BUAP oscuro
$sidebar-accent: #0b2447;  // Azul profundo
$sidebar-hover: #1c3b6a;   // Azul medio para hover
$sidebar-active: #00b5e2;  // Acento claro
$icon-color: #c7d5ee;      // Azul grisáceo para iconos
$text-color: #f1f5ff;      // Texto claro
$logout-bg: #102a4d;       // Fondo botón logout
$logout-hover: #173764;    // Hover botón logout

.sidebar-container {
  height: 100vh;
  background: transparent;
}

.sidebar {
  width: 200px;
  background: linear-gradient(180deg, $sidebar-bg 0%, $sidebar-accent 100%);
  color: $text-color;
  display: flex;
  flex-direction: column;
  padding-top: 2rem;
  padding-bottom: 2rem;
}

nav {
  display: flex;
  flex-direction: column;
  height: 100%;
  justify-content: space-between;
}

.sidebar-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.sidebar-list li {
  display: flex;
  align-items: center;
  padding: 1rem 1.2rem;
  cursor: pointer;
  transition: background 0.18s, color 0.18s;
  font-size: 1rem;
  border-radius: 6px;
  color: $text-color;

  mat-icon {
    margin-right: 0.6rem;
    font-size: 1.2em;
    color: $icon-color;
    transition: color 0.18s;
  }
}

.sidebar-list li.active,
.sidebar-list li:hover {
  background: $sidebar-hover;
  color: $text-color;

  mat-icon {
    color: $text-color;
  }
}

.sidebar-list li.active {
  background: $sidebar-active;
  color: #0b1f3a;

  mat-icon {
    color: #0b1f3a;
  }
}

// Special styling for non-functional items
.sidebar-list li.eventos-academicos {
  opacity: 0.8;

  &:hover {
    background: rgba($sidebar-hover, 0.5);
    opacity: 1;
  }
}

.logout-btn {
  margin: 1.2rem;
  width: calc(100% - 2.4rem);
  background: $logout-bg;
  color: $text-color;
  transition: background 0.18s, color 0.18s;

  &:hover {
    background: $logout-hover;
    color: #fff;
  }
}

.sidebar-toggle {
  position: fixed;
  top: 1rem;
  left: 1rem;
  z-index: 20;
  background: $sidebar-bg;
  color: $icon-color;
  border-radius: 50%;
  box-shadow: 0 2px 8px rgba(0,0,0,0.10);
  display: none;
}

@media (max-width: 992px) {
  .sidebar-toggle {
    display: block;
  }
  .sidebar {
    width: 70vw;
    min-width: 150px;
    max-width: 90vw;
    position: fixed;
    left: 0;
    top: 0;
    height: 100vh;
    transition: width 0.2s;
    box-shadow: 2px 0 8px rgba(0,0,0,0.09);
  }
}
.sidebar-container {
  height: 100%;
  min-height: 100vh;
  background: transparent;
}

.sidebar {
  width: 200px;
  background: linear-gradient(180deg, $sidebar-bg 0%, $sidebar-accent 100%);
  color: $text-color;
  display: flex;
  flex-direction: column;
  padding-top: 2rem;
  padding-bottom: 2rem;
  height: 100%;
}
