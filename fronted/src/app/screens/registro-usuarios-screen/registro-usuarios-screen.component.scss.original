// Estilos base iguales al login
:host {
  display: block;
  min-height: 100vh;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

:root {
  --brand-blue-dark: #005f86;
  --brand-blue-light: #00b5e2;
  --brand-gray: #6d6e71;
}

* {
  box-sizing: border-box;
}

.login-page {
  position: relative;
  min-height: 100vh;
  overflow-x: hidden;
}

/* Background */
.background-container {
  position: fixed;
  inset: 0;
  z-index: 0;
}

.background-image {
  position: absolute;
  inset: 0;
  background-image: url("/assets/images/bibliotecacentral.jpg");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.background-overlay {
  position: absolute;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

/* Content Container */
.content {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  z-index: 1;
}

/* Header */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.5rem 2rem;
}

.logo-container {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.logo-image {
  height: 40px;
  width: auto;
  border-radius: 4px;
}

.logo-text {
  color: #ffffff;
  font-size: 1.5rem;
  font-weight: 700;
  letter-spacing: 0.5px;
}

.social-icons {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.social-link {
  color: #ffffff;
  opacity: 0.8;
  transition: opacity 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.social-link:hover {
  opacity: 1;
}

/* Main Content */
.main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  gap: 1.5rem;
}

/* Mitec Logo */
.mitec-logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 0.5rem;
}

.mitec-bars {
  display: flex;
  gap: 8px;
  margin-bottom: 0.5rem;
}

.bar {
  width: 24px;
  height: 80px;
  border-radius: 12px;
}

.bar-blue-dark {
  background-color: #005F86; /* Pantone 302 C */
}

.bar-white {
  background-color: #ffffff;
}

.bar-blue-light {
  background-color: #00B5E2; /* Pantone 306 C */
}

.bar-gray {
  background-color: #6D6E71; /* Gris lobo */
}

.mitec-text {
  font-size: 2.5rem;
  font-weight: 700;
}

.mi {
  color: var(--brand-blue-light);
}

.tec {
  color: #ffffff;
}

/* Welcome Title */
.welcome-title {
  color: #ffffff;
  font-size: 1.25rem;
  font-weight: 500;
  text-align: center;
}

/* Registration Panel */
.registration-panel {
  width: min(980px, 100%);
  background: rgba(255, 255, 255, 0.92);
  border-radius: 24px;
  padding: clamp(16px, 2vw, 28px);
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(6px);
}

.reg-shell {
  display: grid;
  gap: 20px;
}

/* Role card */
.role-card {
  background: transparent;
  box-shadow: none;
}

.role-card-header {
  display: flex;
  flex-direction: row;
  justify-content: flex-start;
  align-items: center;
  gap: 4px;
  padding-bottom: 8px;
}

.actions-header-colum {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  gap: 2px;
  width: 100%;
}

.role-row {
  width: 100%;
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  flex-wrap: wrap;
  gap: 12px 20px;
  margin-top: 12px;
}

.role-pill {
  display: inline-flex;
  justify-content: center;
  text-align: center;
  padding: 6px 10px;
}

.title-card {
  width: 100%;
  font-family: Nexa-Bold, Arial, sans-serif;
  font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
  margin-bottom: 0.25rem;
  color: #111827;
}

.subtitle-card {
  width: 100%;
  font-family: Nexa-Light, Arial, sans-serif;
  font-size: clamp(1rem, 0.8rem + 0.5vw, 1.25rem);
  color: #1f2937;
  margin-top: 1rem;
}

.text-radio {
  width: 100%;
  font-size: 1.1rem;
  font-family: Nexa, Arial, sans-serif;
  color: #111827;
}

/* Boton regresar */
.actions-row {
  margin: 8px auto 0;
  display: flex;
  justify-content: flex-end;
}

.back-btn {
  border-radius: 30%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: auto !important;
  height: auto !important;
  font-size: 1.9rem;
  color: var(--brand-blue-dark);
}

/* Area de formularios */
.forms-area {
  width: 100%;
}

/* Estilos Material Radio */
.mat-icon {
  width: 100%;
  height: 100%;
}

::ng-deep .mat-mdc-radio-button mat-icon {
  text-align: center;
  font-size: 2.5rem;
  color: var(--brand-blue-dark);
  transition: color 0.3s ease;
}

::ng-deep .mat-mdc-radio-button:hover mat-icon {
  color: var(--brand-blue-dark);
}

::ng-deep .mat-mdc-radio-button .mdc-form-field {
  color: #231f20;
  font-family: Nexa;
  font-size: 20px;
}

::ng-deep .mat-mdc-radio-button.mat-accent {
  --mdc-radio-selected-focus-icon-color: var(--brand-blue-dark);
  --mdc-radio-selected-hover-icon-color: var(--brand-blue-dark);
  --mdc-radio-selected-icon-color: var(--brand-blue-dark);
  --mdc-radio-selected-pressed-icon-color: var(--brand-blue-dark);
  --mat-radio-ripple-color: #000;
  --mat-radio-checked-ripple-color: var(--brand-blue-dark);
}

::ng-deep .mdc-radio {
  display: inline-block;
  position: relative;
  flex: 0 0 auto;
  box-sizing: content-box;
  width: auto;
  height: auto;
  cursor: pointer;
  will-change: opacity, transform, border-color, color;
}

/* Footer */
.footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.5rem 2rem;
  color: #ffffff;
}

.footer-links {
  display: flex;
  gap: 1.5rem;
}

.footer-link {
  color: #ffffff;
  text-decoration: none;
  font-size: 0.875rem;
  font-weight: 500;
  transition: opacity 0.2s ease;
}

.footer-link:hover {
  opacity: 0.8;
}

.copyright {
  font-size: 0.875rem;
}

.copyright-link {
  color: var(--brand-blue-light);
  text-decoration: none;
  transition: opacity 0.2s ease;
}

.copyright-link:hover {
  opacity: 0.8;
  text-decoration: underline;
}

/* Responsive Design */
@media (max-width: 700px) {
  ::ng-deep .mdc-label {
    width: 180px;
  }

  .header {
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
  }

  .social-icons {
    gap: 0.75rem;
  }

  .main-content {
    padding: 1rem;
  }

  .registration-panel {
    padding: 16px;
  }

  .footer {
    flex-direction: column;
    gap: 1rem;
    text-align: center;
    padding: 1rem;
  }

  .footer-links {
    gap: 1rem;
  }

  .bar {
    width: 20px;
    height: 60px;
  }

  .mitec-text {
    font-size: 2rem;
  }

  .welcome-title {
    font-size: 1rem;
  }
}
